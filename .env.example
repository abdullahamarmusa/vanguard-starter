# Local development only. Use separate strong credentials outside this machine.
POSTGRES_DB=vanguard
POSTGRES_USER=vanguard_migrator
POSTGRES_PASSWORD=local-only-migration-password
POSTGRES_APP_PASSWORD=local-only-runtime-password

MIGRATION_DATABASE_URL=postgres://vanguard_migrator:local-only-migration-password@127.0.0.1:5432/vanguard
DATABASE_URL=postgres://vanguard_app:local-only-runtime-password@127.0.0.1:5432/vanguard

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-before-enabling-auth
